{
  "name": "opencode-mem",
  "version": "0.1.0",
  "description": "OpenCode plugin that gives coding agents persistent memory using a local Rust engine with Turso/libSQL vector search",
  "type": "module",
  "main": "dist/plugin.js",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "vector-database",
    "local",
    "standalone"
  ],
  "author": "Jakkaphat Jaisen <vaz@siamstr.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vazw/opencode-agents-memories.git",
    "directory": "plugin"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event",
      "experimental.session.compacting"
    ]
  },
  "files": [
    "dist",
    "index.js",
    "engine",
    "skills",
    "package.json"
  ]
}
